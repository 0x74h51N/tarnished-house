{
  "decoder": "https://www.gstatic.com/draco/versioned/decoders/1.5.7/",
  "floor": {
    "color": "#cccccc",
    "displacementScale": 0.15,
    "textures": {
      "baseColor": "./floor/textures/ground-diff.avif",
      "normalMap": "./floor/textures/ground-norm.avif",
      "armTex": "./floor/textures/ground-arm.avif",
      "displacementMap": "./floor/textures/ground-disp.avif",
      "alphaMap": "./floor/alpha.jpg",
      "repeat": 20
    },
    "geometry": {
      "width": 180,
      "height": 180,
      "widthSegments": 230,
      "heightSegments": 230
    }
  },
  "models": {
    "house": {
      "path": "./abandoned_house/house.gltf",
      "position": {
        "x": 0.02,
        "y": 0.25,
        "z": -12
      },
      "scale": 2.5,
      "castShadow": true,
      "receiveShadow": true
    },
    "bonfire": {
      "path": "./bonfire/bonfire.gltf",
      "audio": {
        "url": "./sounds/fire.mp3",
        "firestartUrl": "./sounds/fire-whoosh.flac",
        "opts": {
          "loop": true,
          "refDistance": 3.5,
          "rolloffFactor": 0.5,
          "volume": 0.75,
          "autoplay": false
        }
      },
      "fireLight": {
        "color": "#ffae42",
        "position": {
          "x": 0,
          "y": 0.28,
          "z": 0
        },
        "intensity": 35,
        "distance": 12.5,
        "decay": 0.8,
        "animation": {
          "intensity": {
            "speed": 12,
            "amplitude": 4
          },
          "position": {
            "speed": 11,
            "amplitude": 0.05
          },
          "distance": {
            "speed": 10,
            "amplitude": 1
          }
        },
        "helper": {
          "size": 0.2
        }
      },
      "inst-1": {
        "scale": 2.55,
        "position": {
          "x": -0.55,
          "y": 0.089,
          "z": 2
        },
        "rotation": { "x": 0, "y": 0, "z": 0 },
        "castShadow": true,
        "receiveShadow": true
      }
    },
    "spawnable": {
      "trees": {
        "path": "./trees/trees.gltf",
        "spawn": {
          "count": 90,
          "yPosition": -0.11,
          "scale": {
            "min": 0.5,
            "max": 0.7
          },
          "radius": {
            "min": 16,
            "max": 66
          },
          "minDistance": 8,
          "castShadow": true,
          "receiveShadow": true,
          "rotation": {
            "y": { "min": -0.5, "max": 0.5 }
          }
        }
      },
      "bushes": {
        "path": "./bushes/bushes.gltf",
        "spawn": {
          "count": 60,
          "scale": {
            "min": 0.4,
            "max": 1.3
          },
          "radius": {
            "min": 8,
            "max": 35
          },
          "minDistance": 1,
          "castShadow": true,
          "receiveShadow": true
        },
        "rotation": {
          "y": { "min": 0, "max": 2 }
        }
      },
      "graves": {
        "path": "./gravestones/graves.gltf",
        "spawn": {
          "count": 55,
          "scale": {
            "min": 0.21,
            "max": 0.22
          },
          "radius": {
            "min": 14,
            "max": 55
          },
          "minDistance": 3,
          "castShadow": true,
          "receiveShadow": true,
          "rotation": {
            "z": { "min": -0.02, "max": 0.02 },
            "y": 1.5,
            "x": { "min": -0.015, "max": 0.015 }
          }
        }
      },
      "branches": {
        "path": "./branches/branches.gltf",
        "spawn": {
          "count": 40,

          "scale": {
            "min": 3,
            "max": 4.7
          },
          "radius": {
            "min": 10,
            "max": 45
          },
          "minDistance": 5,
          "castShadow": true,
          "receiveShadow": false,
          "rotation": {
            "y": { "min": 0, "max": 2 }
          }
        }
      }
