        "firestartUrl": "./sounds/fire-whoosh.flac",
        "opts": {
          "loop": true,
          "refDistance": 3.5,
          "rolloffFactor": 0.5,
          "volume": 0.75,
          "autoplay": false
        }
      },
      "inst-1": {
