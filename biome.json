{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/static",
      "!**/*.{glsl,vert,frag}"
    ]
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },

  "formatter": {
    "enabled": true,
    "lineWidth": 80,
    "indentStyle": "space",
    "indentWidth": 2
  },

  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "always",
      "trailingCommas": "none"
    }
  }
}
