{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node", "vite/client", "vite-plugin-glsl/ext"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"],
      "components/*": ["src/components/*"],
      "config": ["./config.json"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
